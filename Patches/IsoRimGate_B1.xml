<?xml version="1.0" encoding="utf-8"?>
<!-- IsoRim Waylith - VFE Factory Pack, batch B1 gate: conveyor pieces and the factory hopper (generated by tools/vfefactory_b1_defs.js).
     BELT HEIGHT RULE: every piece's top and surfaceHeight is 0.22 (Pack.BeltTop): items ride at it and enter or leave machines
     at it; factory models (later batches) put the bottom of every opening there. See README. -->
<!-- IsoRim Api 39 (ModelDef.byGraphic): binds the B1 defs to VFE's things and maps each runtime sprite path to a model and a
     yaw. A Graphic_Multi sprite's model turns with the thing; a one-direction sprite (turns, 2-input mergers, 2-output
     splitters) is drawn north-up, so one OBJ covers the same piece in every direction. 2-output splitters match by prefix:
     the suffix after the output pair is ignored (user 2026-10-29); one entry per belt facing (facing filter, round 2),
     as the facing says which side feeds the splitter (the input behind it). -->
<Patch>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>39</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VFEF_Conveyor"]</xpath>
      <value>
        <thingDef>VFEFactory_Conveyor</thingDef>
        <byGraphic>
          <li><path>Things/Building/ConveyorBelts/Conveyor</path><model>Models/vfef_belt.obj</model></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorRefuelingPort</path><model>Models/vfef_refuel_port.obj</model></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorFilter</path><model>Models/vfef_filter.obj</model></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorMerger</path><model>Models/vfef_merger3.obj</model></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorSplitter</path><model>Models/vfef_splitter3.obj</model></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorTurnLeft_north</path><model>Models/vfef_turn_left.obj</model></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorTurnRight_north</path><model>Models/vfef_turn_right.obj</model></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorTurnLeft_east</path><model>Models/vfef_turn_left.obj</model><yaw>90</yaw></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorTurnRight_east</path><model>Models/vfef_turn_right.obj</model><yaw>90</yaw></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorTurnLeft_south</path><model>Models/vfef_turn_left.obj</model><yaw>180</yaw></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorTurnRight_south</path><model>Models/vfef_turn_right.obj</model><yaw>180</yaw></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorTurnLeft_west</path><model>Models/vfef_turn_left.obj</model><yaw>270</yaw></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorTurnRight_west</path><model>Models/vfef_turn_right.obj</model><yaw>270</yaw></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorMerger_EastNorth_south</path><model>Models/vfef_merger2_l.obj</model><yaw>180</yaw></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorMerger_EastNorth_west</path><model>Models/vfef_merger2_r.obj</model><yaw>270</yaw></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorMerger_EastSouth_north</path><model>Models/vfef_merger2_r.obj</model></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorMerger_EastSouth_west</path><model>Models/vfef_merger2_l.obj</model><yaw>270</yaw></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorMerger_EastWest_north</path><model>Models/vfef_merger2_t.obj</model></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorMerger_EastWest_south</path><model>Models/vfef_merger2_t.obj</model><yaw>180</yaw></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorMerger_NorthSouth_east</path><model>Models/vfef_merger2_t.obj</model><yaw>90</yaw></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorMerger_NorthSouth_west</path><model>Models/vfef_merger2_t.obj</model><yaw>270</yaw></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorMerger_WestNorth_east</path><model>Models/vfef_merger2_l.obj</model><yaw>90</yaw></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorMerger_WestNorth_south</path><model>Models/vfef_merger2_r.obj</model><yaw>180</yaw></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorMerger_WestSouth_north</path><model>Models/vfef_merger2_l.obj</model></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorMerger_WestSouth_east</path><model>Models/vfef_merger2_r.obj</model><yaw>90</yaw></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorSplitter_EastNorth</path><prefix>true</prefix><facing>North</facing><model>Models/vfef_splitter2_fr.obj</model></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorSplitter_EastNorth</path><prefix>true</prefix><facing>East</facing><model>Models/vfef_splitter2_fl.obj</model><yaw>90</yaw></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorSplitter_EastSouth</path><prefix>true</prefix><facing>East</facing><model>Models/vfef_splitter2_fr.obj</model><yaw>90</yaw></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorSplitter_EastSouth</path><prefix>true</prefix><facing>South</facing><model>Models/vfef_splitter2_fl.obj</model><yaw>180</yaw></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorSplitter_EastWest</path><prefix>true</prefix><facing>North</facing><model>Models/vfef_splitter2_t.obj</model></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorSplitter_EastWest</path><prefix>true</prefix><facing>South</facing><model>Models/vfef_splitter2_t.obj</model><yaw>180</yaw></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorSplitter_NorthSouth</path><prefix>true</prefix><facing>East</facing><model>Models/vfef_splitter2_t.obj</model><yaw>90</yaw></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorSplitter_NorthSouth</path><prefix>true</prefix><facing>West</facing><model>Models/vfef_splitter2_t.obj</model><yaw>270</yaw></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorSplitter_WestNorth</path><prefix>true</prefix><facing>North</facing><model>Models/vfef_splitter2_fl.obj</model></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorSplitter_WestNorth</path><prefix>true</prefix><facing>West</facing><model>Models/vfef_splitter2_fr.obj</model><yaw>270</yaw></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorSplitter_WestSouth</path><prefix>true</prefix><facing>South</facing><model>Models/vfef_splitter2_fr.obj</model><yaw>180</yaw></li>
          <li><path>Things/Building/ConveyorBelts/ConveyorSplitter_WestSouth</path><prefix>true</prefix><facing>West</facing><model>Models/vfef_splitter2_fl.obj</model><yaw>270</yaw></li>
        </byGraphic>
      </value>
    </apply>
  </Operation>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>39</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VFEF_UndergroundConveyorEntrance"]</xpath>
      <value>
        <thingDef>VFEFactory_UndergroundConveyorEntrance</thingDef>
        <byGraphic>
          <li><path>Things/Building/UndergroundConveyorEntrance/ConveyorUndergroundEntrance</path><model>Models/vfef_ug_entrance.obj</model></li>
        </byGraphic>
      </value>
    </apply>
  </Operation>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>39</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VFEF_UndergroundConveyorExit"]</xpath>
      <value>
        <thingDef>VFEFactory_UndergroundConveyorExit</thingDef>
        <byGraphic>
          <li><path>Things/Building/UndergroundConveyorExit/ConveyorUndergroundExit</path><model>Models/vfef_ug_exit.obj</model></li>
        </byGraphic>
      </value>
    </apply>
  </Operation>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>39</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VFEF_FactoryHopper"]</xpath>
      <value>
        <thingDef>VFEFactory_FactoryHopper</thingDef>
        <byGraphic>
          <li><path>Things/Building/FactoryHopper/FactoryHopper_Unset</path><model>Models/vfef_hopper_unset.obj</model></li>
          <li><path>Things/Building/FactoryHopper/FactoryHopper_Input</path><model>Models/vfef_hopper_input.obj</model></li>
          <li><path>Things/Building/FactoryHopper/FactoryHopper_Output</path><model>Models/vfef_hopper_output.obj</model></li>
        </byGraphic>
      </value>
    </apply>
  </Operation>
</Patch>
