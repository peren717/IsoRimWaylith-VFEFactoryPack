<?xml version="1.0" encoding="utf-8"?>
<!-- IsoRim Waylith - VFE Factory Pack, batch B5 gate: the autofarmer and the linkables (generated by tools/vfefactory_b5_defs.js).
     No wallFit: the models keep their real height. -->
<Patch>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>39</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VFEF_Autofarmer"]</xpath>
      <value>
        <thingDef>VFEFactory_Autofarmer</thingDef>
      </value>
    </apply>
  </Operation>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>39</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VFEF_Booster"]</xpath>
      <value>
        <thingDef>VFEFactory_Booster</thingDef>
      </value>
    </apply>
  </Operation>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>39</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VFEF_Heatsink"]</xpath>
      <value>
        <thingDef>VFEFactory_Heatsink</thingDef>
      </value>
    </apply>
  </Operation>
</Patch>
