<?xml version="1.0" encoding="utf-8"?>
<!-- IsoRim Waylith - VFE Factory Pack, batch B3 gate: the 3x4 and 3x5 factories (generated by tools/vfefactory_b3_defs.js).
     MACHINE PORT RULE: the bottom of every factory input / output port is at 0.45 (Pack MACHINE_PORT), a bit above the
     factory hopper's top (0.40); belts, the hoppers' belt side and underground mouths keep the belt top 0.22. See README.
     No wallFit: the models keep their real height, so IsoRim's Api.ModelHeight reads the OBJ top and IsoRimZ's height rule
     keeps floors off the tall ones (smelter, biofuel refinery). -->
<Patch>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>39</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VFEF_AutomatedSmelter"]</xpath>
      <value>
        <thingDef>VFEFactory_AutomatedSmelter</thingDef>
        <byState>
          <li><state>vfef_unpowered</state><model>Models/vfef_smelter_unlit.obj</model></li>
        </byState>
      </value>
    </apply>
  </Operation>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>39</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VFEF_AutomatedBiofuelRefinery"]</xpath>
      <value>
        <thingDef>VFEFactory_AutomatedBiofuelRefinery</thingDef>
      </value>
    </apply>
  </Operation>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>39</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VFEF_AutomatedAmmunitionPress"]</xpath>
      <value>
        <thingDef>VFEFactory_AutomatedAmmunitionPress</thingDef>
      </value>
    </apply>
  </Operation>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>39</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VFEF_ConveyorOven"]</xpath>
      <value>
        <thingDef>VFEFactory_ConveyorOven</thingDef>
        <byState>
          <li><state>vfef_unpowered</state><model>Models/vfef_oven_unlit.obj</model></li>
        </byState>
      </value>
    </apply>
  </Operation>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>39</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VFEF_Autoloom"]</xpath>
      <value>
        <thingDef>VFEFactory_Autoloom</thingDef>
      </value>
    </apply>
  </Operation>
  <!-- Vanilla Cooking Expanded only -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Cooking Expanded</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
          <minVersion>39</minVersion>
          <apply Class="PatchOperationAdd">
            <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VFEF_AutomatedCannery"]</xpath>
            <value>
              <thingDef>VFEFactory_AutomatedCannery</thingDef>
            </value>
          </apply>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
