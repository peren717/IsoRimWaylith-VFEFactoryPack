<?xml version="1.0" encoding="utf-8"?>
<!-- IsoRim Waylith - VFE Factory Pack, batch B2 gate: the six 3x3 factories (generated by tools/vfefactory_b2_defs.js).
     MACHINE PORT RULE: the bottom of every factory input / output port is at 0.45 (Pack MACHINE_PORT), a bit above the
     factory hopper's top (0.40); belts, the hoppers' belt side and underground mouths keep the belt top 0.22. See README.
     No wallFit: the models keep their real height, so IsoRim's Api.ModelHeight reads the OBJ top and IsoRimZ's height rule
     keeps floors off the tall ones (drill platform, distillery). -->
<Patch>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>39</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VFEF_AutomatedDrillPlatform"]</xpath>
      <value>
        <thingDef>VFEFactory_AutomatedDrillPlatform</thingDef>
      </value>
    </apply>
  </Operation>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>39</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VFEF_AutomatedMasonrySaw"]</xpath>
      <value>
        <thingDef>VFEFactory_AutomatedMasonrySaw</thingDef>
      </value>
    </apply>
  </Operation>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>39</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VFEF_AutomatedMincer"]</xpath>
      <value>
        <thingDef>VFEFactory_AutomatedMincer</thingDef>
      </value>
    </apply>
  </Operation>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>39</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VFEF_AutomatedDistillery"]</xpath>
      <value>
        <thingDef>VFEFactory_AutomatedDistillery</thingDef>
      </value>
    </apply>
  </Operation>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>39</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VFEF_AutomatedCrematorium"]</xpath>
      <value>
        <thingDef>VFEFactory_AutomatedCrematorium</thingDef>
        <byState>
          <li><state>vfef_unpowered</state><model>Models/vfef_crematorium_unlit.obj</model></li>
        </byState>
      </value>
    </apply>
  </Operation>
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>39</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VFEF_AutomatedFishfarm"]</xpath>
      <value>
        <thingDef>VFEFactory_AutomatedFishfarm</thingDef>
      </value>
    </apply>
  </Operation>
</Patch>
