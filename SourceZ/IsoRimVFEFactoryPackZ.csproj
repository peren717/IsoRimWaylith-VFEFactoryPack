<Project Sdk="Microsoft.NET.Sdk">
  <!-- The pack's IsoRimZ part, loaded only with IsoRimZ active (LoadFolders.xml: 1.7/IsoRimZ): VFE Factory on floored maps
       (autofarmer zones kept on their own floor). ProjectZ: public ProjectZ.Api only (Api 2);
       override with -p:ProjectZDll=<path> to build against a worktree. VFE Factory is reached by name at run time (no
       reference), so a VFE update cannot stop the pack loading. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>IsoRimWaylith_VFEFactoryPackZ</AssemblyName>
    <RootNamespace>IsoRimVFEFactoryPackZ</RootNamespace>
    <OutputPath>..\1.7\IsoRimZ\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Optimize>true</Optimize>
    <RimDir Condition="'$(RimDir)' == ''">..\..\..</RimDir>
    <ProjectZDll Condition="'$(ProjectZDll)' == ''">..\..\IsoRimProjectZ\1.7\Assemblies\IsoRimProjectZ.dll</ProjectZDll>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="obj\**;bin\**" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(RimDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimDir)\UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(RimDir)\..\..\workshop\content\294100\2009463077\1.7\Assemblies\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="IsoRimProjectZ"><HintPath>$(ProjectZDll)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
