<?xml version="1.0" encoding="utf-8"?>
<!-- IsoRim Waylith - VFE Factory Pack, batch B2: the six 3x3 factories (generated by tools/vfefactory_b2_defs.js).
     MACHINE PORT RULE: the bottom of every factory input / output port is at 0.45 (Pack MACHINE_PORT), a bit above the
     factory hopper's top (0.40); belts, the hoppers' belt side and underground mouths keep the belt top 0.22. See README.
     No wallFit: the models keep their real height, so IsoRim's Api.ModelHeight reads the OBJ top and IsoRimZ's height rule
     keeps floors off the tall ones (drill platform, distillery). -->
<!-- These defs bind nothing by themselves (no thingDef): Patches/IsoRimGate_B2.xml binds them on IsoRim Api 39+. -->
<Defs>
  <IsoRim.ModelDef>   <!-- derrick and drill motor 2.97: taller than a storey -->
    <defName>R3D_VFEF_AutomatedDrillPlatform</defName>
    <model>Models/vfef_drill.obj</model>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef>   <!-- side housings 1.15 -->
    <defName>R3D_VFEF_AutomatedMasonrySaw</defName>
    <model>Models/vfef_masonry_saw.obj</model>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef>   <!-- body 0.95 -->
    <defName>R3D_VFEF_AutomatedMincer</defName>
    <model>Models/vfef_mincer.obj</model>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef>   <!-- still 1.98: taller than a storey -->
    <defName>R3D_VFEF_AutomatedDistillery</defName>
    <model>Models/vfef_distillery.obj</model>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef>   <!-- furnace 1.38; lit mouth, dark without power -->
    <defName>R3D_VFEF_AutomatedCrematorium</defName>
    <model>Models/vfef_crematorium.obj</model>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef>   <!-- Odyssey (VFE loads it only with Odyssey; IsoRim skips an unknown thingDef); frame 1.0 -->
    <defName>R3D_VFEF_AutomatedFishfarm</defName>
    <model>Models/vfef_fishfarm.obj</model>
  </IsoRim.ModelDef>
</Defs>
