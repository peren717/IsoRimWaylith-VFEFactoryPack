<?xml version="1.0" encoding="utf-8"?>
<!-- IsoRim Waylith - VFE Factory Pack, batch B3: the 3x4 and 3x5 factories (generated by tools/vfefactory_b3_defs.js).
     MACHINE PORT RULE: the bottom of every factory input / output port is at 0.45 (Pack MACHINE_PORT), a bit above the
     factory hopper's top (0.40); belts, the hoppers' belt side and underground mouths keep the belt top 0.22. See README.
     No wallFit: the models keep their real height, so IsoRim's Api.ModelHeight reads the OBJ top and IsoRimZ's height rule
     keeps floors off the tall ones (smelter, biofuel refinery). -->
<!-- These defs bind nothing by themselves (no thingDef): Patches/IsoRimGate_B3.xml binds them on IsoRim Api 39+. -->
<Defs>
  <IsoRim.ModelDef>   <!-- domed furnace 2.08: taller than a storey; glow slots, dark without power -->
    <defName>R3D_VFEF_AutomatedSmelter</defName>
    <model>Models/vfef_smelter.obj</model>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef>   <!-- tanks 1.66, pipes 1.84: taller than a storey -->
    <defName>R3D_VFEF_AutomatedBiofuelRefinery</defName>
    <model>Models/vfef_biofuel.obj</model>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef>   <!-- press wheel 1.57 -->
    <defName>R3D_VFEF_AutomatedAmmunitionPress</defName>
    <model>Models/vfef_ammo_press.obj</model>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef>   <!-- oven box 1.30; lit tunnel, dark without power -->
    <defName>R3D_VFEF_ConveyorOven</defName>
    <model>Models/vfef_oven.obj</model>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef>   <!-- feeder box 1.15 -->
    <defName>R3D_VFEF_Autoloom</defName>
    <model>Models/vfef_autoloom.obj</model>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef MayRequire="VanillaExpanded.VCookE">   <!-- feed box 1.15; only with Vanilla Cooking Expanded -->
    <defName>R3D_VFEF_AutomatedCannery</defName>
    <model>Models/vfef_cannery.obj</model>
  </IsoRim.ModelDef>
</Defs>
