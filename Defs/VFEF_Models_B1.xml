<?xml version="1.0" encoding="utf-8"?>
<!-- IsoRim Waylith - VFE Factory Pack, batch B1: conveyor pieces and the factory hopper (generated by tools/vfefactory_b1_defs.js).
     BELT HEIGHT RULE: every piece's top and surfaceHeight is 0.22 (Pack.BeltTop): items ride at it and enter or leave machines
     at it; factory models (later batches) put the bottom of every opening there. See README. -->
<!-- These defs bind nothing by themselves (no thingDef): Patches/IsoRimGate_B1.xml binds them on IsoRim Api 39+, with the
     byGraphic lists (VFE picks each belt piece's sprite at runtime). An older IsoRim keeps its automatic shapes for the belts
     instead of a straight belt model on every turn. -->
<Defs>
  <IsoRim.ModelDef>
    <defName>R3D_VFEF_Conveyor</defName>
    <model>Models/vfef_belt.obj</model>
    <surfaceHeight>0.22</surfaceHeight>
    <outlineMinSize>0.75</outlineMinSize>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef>
    <defName>R3D_VFEF_UndergroundConveyorEntrance</defName>
    <model>Models/vfef_ug_entrance.obj</model>
    <surfaceHeight>0.22</surfaceHeight>
    <outlineMinSize>0.75</outlineMinSize>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef>
    <defName>R3D_VFEF_UndergroundConveyorExit</defName>
    <model>Models/vfef_ug_exit.obj</model>
    <surfaceHeight>0.22</surfaceHeight>
    <outlineMinSize>0.75</outlineMinSize>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef>
    <defName>R3D_VFEF_FactoryHopper</defName>
    <model>Models/vfef_hopper_unset.obj</model>
    <surfaceHeight>0.22</surfaceHeight>
    <outlineMinSize>0.5</outlineMinSize>
  </IsoRim.ModelDef>
</Defs>
