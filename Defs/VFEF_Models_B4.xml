<?xml version="1.0" encoding="utf-8"?>
<!-- IsoRim Waylith - VFE Factory Pack, batch B4: the 5x5 and 5x3 factories (generated by tools/vfefactory_b4_defs.js).
     MACHINE PORT RULE: the bottom of every factory input / output port is at 0.45 (Pack MACHINE_PORT), a bit above the
     factory hopper's top (0.40); belts, the hoppers' belt side and underground mouths keep the belt top 0.22. See README.
     No wallFit: the models keep their real height, so IsoRim's Api.ModelHeight reads the OBJ top and IsoRimZ's height rule
     keeps floors off the tall one (alloy forge). -->
<!-- These defs bind nothing by themselves (no thingDef): Patches/IsoRimGate_B4.xml binds them on IsoRim Api 39+. -->
<Defs>
  <IsoRim.ModelDef>   <!-- robot columns 1.25 -->
    <defName>R3D_VFEF_AutomatedAssembler</defName>
    <model>Models/vfef_assembler.obj</model>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef>   <!-- tanks 1.40, handwheel 1.79: taller than a storey; lit parts, dark without power -->
    <defName>R3D_VFEF_AutomatedAlloyForge</defName>
    <model>Models/vfef_alloy_forge.obj</model>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef>   <!-- domed cylinders 1.52 -->
    <defName>R3D_VFEF_AutomatedMachiningBay</defName>
    <model>Models/vfef_machining_bay.obj</model>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef>   <!-- cabinet 1.20 -->
    <defName>R3D_VFEF_NeutroamineSynthesizer</defName>
    <model>Models/vfef_neutroamine.obj</model>
  </IsoRim.ModelDef>
  <IsoRim.ModelDef>   <!-- bowl 1.28 -->
    <defName>R3D_VFEF_MedicineGranulator</defName>
    <model>Models/vfef_medicine.obj</model>
  </IsoRim.ModelDef>
</Defs>
